PORT=3001
# Comma-separated list of allowed browser origins (no trailing slash).
CLIENT_ORIGIN=http://localhost:5173

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/system-design-interviewer

CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional: Razorpay (premium pass). Use rzp_test_ keys in development.
# Without these the app still runs; premium problems just can't be unlocked.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# PREMIUM_PASS_PRICE_PAISE=29900
# PREMIUM_PASS_DAYS=30

# Optional: interview time limits in minutes (the interview auto-ends at the limit).
# FREE_SESSION_MINUTES=15
# PREMIUM_SESSION_MINUTES=30

# Optional: interviews per day, resetting at midnight in QUOTA_TIMEZONE.
# FREE_DAILY_INTERVIEWS=1
# PREMIUM_DAILY_INTERVIEWS=3
# QUOTA_TIMEZONE=Asia/Kolkata

# Optional: local-only API testing without a Clerk session. Leave unset in real use.
# DEV_AUTH_USER_ID=user_local_dev
